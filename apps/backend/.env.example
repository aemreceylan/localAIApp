# ==============================================================================
# Chotonack AI (Backend Gateway) - Environment Configuration Template
# ==============================================================================
# Bu dosya, backend servisinin çalışması için gereken temel ortam değişkenlerini tanımlar.
# Yerel geliştirme için bu dosyayı kopyalayarak '.env' adı ile kaydediniz:
#   cp .env.example .env
# ==============================================================================

# Çalışma Ortamı (development | production | test)
NODE_ENV=development

# Sunucu Ağ Yapılandırması
HOST=localhost
PORT=3000

# CORS Yetkili İstemci Adresi (User Interface / Admin Interface)
CORS_ORIGIN=http://localhost:5173

# Yerel LLM Çıkarım Motoru (Ollama / vLLM API adresi)
OLLAMA_BASE_URL=http://localhost:11434/api

# Birincil Doküman Veritabanı (MongoDB Bağlantı URI)
MONGODB_URI=mongodb://localhost:27017/nexusai

# Bellek İçi Önbellek, Oturum İptal Listesi ve BullMQ Kuyruğu (Redis)
REDIS_URL=redis://localhost:6379

# Vektör Veritabanı (Qdrant RAG ve Semantik Arama)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_if_secured
